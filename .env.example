VITE_SUPABASE_URL=https://mbgiaevxiabtdweydgwm.supabase.co
# Preferred name for Supabase's browser-safe publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible fallback for older local/deployment configurations.
VITE_SUPABASE_ANON_KEY=

# Use true only while developing without a trained ONNX model.
VITE_USE_MOCK_VISION=false
# Example: material_plastic opens the broad-material result flow in local mock mode.
VITE_MOCK_VISION_RESULT=plastic_water_bottle
# v69 uses all four files listed in this calibrated runtime configuration.
VITE_AI_ENSEMBLE_ENABLED=true
VITE_AI_ENSEMBLE_CONFIG_PATH=/models/waste_classifier_ensemble.json
VITE_AI_MODEL_PATH=/models/waste_classifier.onnx
VITE_AI_LABELS_PATH=/models/labels.json
VITE_AI_NORMALIZATION=zero-one
VITE_AI_MIN_ACCEPTANCE=0.55
VITE_AI_MIN_MARGIN=0.15
VITE_AI_SPECIAL_HANDLING_MIN_ACCEPTANCE=0.8
VITE_AI_TIMEOUT_MS=60000

# Separate seven-class material model used only when v69 rejects an exact item.
VITE_MATERIAL_MODEL_ENABLED=true
VITE_MATERIAL_MODEL_PATH=/models/waste_material_classifier.onnx
VITE_MATERIAL_LABELS_PATH=/models/material_labels.json
VITE_MATERIAL_MIN_ACCEPTANCE=0.95
VITE_MATERIAL_MIN_MARGIN=0.05
VITE_MATERIAL_ELECTRONIC_MIN_ACCEPTANCE=0.70

VITE_MIXED_MODEL_ENABLED=true
VITE_MIXED_MODEL_PATH=/models/waste_mixed_classifier.onnx
VITE_MIXED_LABELS_PATH=/models/mixed_labels.json
VITE_MIXED_MIN_ACCEPTANCE=0.70

# Reviewed v73 candidate router. Keep disabled unless the three matching v73r1
# ONNX heads and label files are present in public/models.
VITE_REVIEWED_ROUTER_ENABLED=true
VITE_DESTINATION_MODEL_PATH=/models/v73r1-destination.onnx
VITE_DESTINATION_LABELS_PATH=/models/v73r1-destination-labels.json
VITE_DESTINATION_FALLBACK_MIN_ACCEPTANCE=0.70
VITE_DESTINATION_FALLBACK_MIN_MARGIN=0.00
VITE_DESTINATION_AGREEMENT_DISCOUNT=0.10
VITE_DESTINATION_OVERRIDE_MIN_ACCEPTANCE=0.95
VITE_DESTINATION_OVERRIDE_MIN_MARGIN=0.10

# Detection is focus assistance, not the final classifier. The full focus frame
# remains authoritative; a sufficiently large/high-confidence crop can only
# rescue a result that would otherwise request feedback.
VITE_OBJECT_DETECTOR_ENABLED=true
VITE_OBJECT_DETECTOR_MODEL_PATH=/models/waste_object_detector.onnx
VITE_OBJECT_DETECTOR_MIN_CONFIDENCE=0.30
VITE_OBJECT_DETECTOR_RESCUE_MIN_CONFIDENCE=0.70
VITE_OBJECT_DETECTOR_RESCUE_MIN_AREA=0.10
VITE_OBJECT_DETECTOR_DEBUG=false

# Optional legacy bin reranking. Leave false to preserve evaluated v69 predictions.
VITE_BIN_MODEL_ENABLED=false
VITE_BIN_MODEL_PATH=/models/waste_bin_classifier.onnx
VITE_BIN_LABELS_PATH=/models/bin_labels.json
VITE_BIN_ENSEMBLE_WEIGHT=0.53
VITE_BIN_MIN_ACCEPTANCE=0.45
VITE_BIN_MIN_MARGIN=0.05
VITE_AI_WITHIN_BIN_MIN_ACCEPTANCE=0.18
VITE_AI_WITHIN_BIN_MIN_MARGIN=0.02

VITE_COMPONENT_MODEL_ENABLED=true
VITE_COMPONENT_MODEL_PATH=/models/waste_components.onnx
VITE_COMPONENT_LABELS_PATH=/models/component_labels.json
VITE_COMPONENT_INPUT_SIZE=416
VITE_COMPONENT_MIN_ACCEPTANCE=0.5
VITE_COMPONENT_TIMEOUT_MS=2500

# Set true only for private/local field testing. Keep false for client builds.
VITE_TRAINING_MODE=false

# Temporary correction prompt shown after a result. Set false to remove it.
VITE_RESULT_FEEDBACK=true

# Automatically send consented corrections when Supabase is configured.
VITE_FEEDBACK_AUTO_UPLOAD=true
